# Postgres
POSTGRES_DB=monopoly
POSTGRES_USER=monopoly
POSTGRES_PASSWORD=change-me

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_REALM=monopoly
KEYCLOAK_API_CLIENT_ID=monopoly-api
KEYCLOAK_API_CLIENT_SECRET=change-me
KEYCLOAK_FRONT_CLIENT_ID=monopoly-front

# Garage (S3-compatible object storage) - generated after first boot,
# see docker/garage/README.md
GARAGE_S3_ACCESS_KEY=change-me
GARAGE_S3_SECRET_KEY=change-me
GARAGE_S3_ENDPOINT=http://localhost:3900
GARAGE_S3_BUCKET=monopoly-uploads

# API
API_PORT=8080

# Front
FRONT_PORT=4200
