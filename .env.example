# Copiez ce fichier en .env puis adaptez les valeurs.
# docker compose lit .env automatiquement.

# Port publié sur la machine hôte (HTTP et HTTPS y répondent tous les deux)
MONOPOLIE_PORT=3000

# IP ou noms de la machine hôte à inscrire dans le certificat HTTPS local.
# Docker masque l'IP réseau réelle : sans cette valeur, les navigateurs qui
# forcent le HTTPS signalent un nom de certificat invalide.
# Plusieurs valeurs possibles, séparées par des virgules.
MONOPOLIE_HOSTS=192.168.1.22

# Secret de signature des sessions. À définir pour que les connexions
# survivent aux redémarrages. Générez-le avec :
#   openssl rand -hex 48
JWT_SECRET=

# --- PostgreSQL ---
POSTGRES_USER=monopolie
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=monopolie

# --- Stockage objet (MinIO) ---
S3_BUCKET=monopolie
S3_ACCESS_KEY=monopolie
S3_SECRET_KEY=changez-moi-aussi
S3_REGION=us-east-1
MINIO_CONSOLE_PORT=9001
